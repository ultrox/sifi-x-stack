{
  "manifest_version": 3,
  "name": "SIFI X Focus",
  "version": "0.5.4",
  "description": "Predictable saved Home editions, Following by default, one video at a time, and deliberate reply pages.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "editions-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "editions-core.js",
        "editions.js",
        "focus.js",
        "replies-core.js",
        "replies.js"
      ],
      "css": [
        "focus.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "editions-store.js"
  }
}
