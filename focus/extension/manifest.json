{
  "manifest_version": 3,
  "name": "SIFI X Focus",
  "version": "0.4.1",
  "description": "Following by default, one video at a time, and Home/replies limited to six deliberate pages.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "focus.js",
        "replies-core.js",
        "replies.js"
      ],
      "css": [
        "focus.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
